    <Error Condition="!Exists('$(SetVarsBat)')" Text="Intel oneAPI was not found. Set OneApiRoot to the directory containing setvars.bat." />
    <Message Text="Visual Studio: $(VsInstallPath)" Importance="High" />
    <Message Text="Intel oneAPI:   $(OneApiRoot)" Importance="High" />
    <Message Text="Configuration:  $(Configuration)|$(Platform)" Importance="High" />
    <Message Text="Output:         $(ArtifactDir)" Importance="High" />
    <MakeDir Directories="$(ArtifactDir);$(CppObjDir);$(FortranObjDir);$(OutDir);$(IntDir)" />

    <ItemGroup>
      <CppCompileLine Include="/nologo" />
      <CppCompileLine Include="/c" />
      <CppCompileLine Include="/MT" />
      <CppCompileLine Include="/O2" />
      <CppCompileLine Include="/Zi" />
      <CppCompileLine Include="/EHsc" />
      <CppCompileLine Include="/W3" />
      <CppCompileLine Include="/DWIN32" />
      <CppCompileLine Include="/DNDEBUG" />
      <CppCompileLine Include="/D_WINDOWS" />
      <CppCompileLine Include="/D_USRDLL" />
      <CppCompileLine Include="/DCROP_EXPORTS" />
      <CppCompileLine Include="/D_INTERFACE" />
      <CppCompileLine Include="/Fo$(CppObjFromCrop)" />
      <CppCompileLine Include="/Fd$(CppObjFromCrop)Maizsim.pdb" />
      <CppCompileLine Include="@(CppSource->'&quot;%(Identity)&quot;')" />
      <CppLinkLine Include="/nologo" />
      <CppLinkLine Include="/DLL" />
      <CppLinkLine Include="/DEBUG" />
      <CppLinkLine Include="/SUBSYSTEM:CONSOLE" />
      <CppLinkLine Include="/OPT:REF" />
      <CppLinkLine Include="/OPT:ICF" />
      <CppLinkLine Include="/DYNAMICBASE:NO" />
      <CppLinkLine Include="/OUT:&quot;$(ArtifactFromCrop)Maizsim.dll&quot;" />
      <CppLinkLine Include="/IMPLIB:&quot;$(CppObjFromCrop)Maizsim.lib&quot;" />
      <CppLinkLine Include="/PDB:&quot;$(CppObjFromCrop)Maizsim.pdb&quot;" />
      <CppLinkLine Include="/MAP:&quot;$(CppObjFromCrop)Maizsim.map&quot;" />
      <CppLinkLine Include="@(CppSource->'&quot;$(CppObjFromCrop)%(Filename).obj&quot;')" />
      <CppLinkLine Include="&quot;$(CppObjFromCrop)Crop.res&quot;" />
      <FortranLine Include="/nologo" />
      <FortranLine Include="/Qzero" />
      <FortranLine Include="/Qinit:arrays" />
      <FortranLine Include="/warn:shape" />
      <FortranLine Include="/iface:cvf" />
      <FortranLine Include="/Qdiag-disable:6375" />
      <FortranLine Include="/module:$(FortranObjFromSoil)" />
      <FortranLine Include="/Fo$(FortranObjFromSoil)" />
      <FortranLine Include="@(FortranSource->'&quot;%(Identity)&quot;')" />
      <FortranLine Include="&quot;$(FortranObjFromSoil)maizsim.res&quot;" />
      <FortranLine Include="&quot;$(CppObjFromCrop)Maizsim.lib&quot;" />
    </ItemGroup>

    <WriteLinesToFile File="$(CppCompileResponse)" Lines="@(CppCompileLine)" Overwrite="true" Encoding="ASCII" />
    <WriteLinesToFile File="$(CppLinkResponse)" Lines="@(CppLinkLine)" Overwrite="true" Encoding="ASCII" />
    <WriteLinesToFile File="$(FortranResponse)" Lines="@(FortranLine)" Overwrite="true" Encoding="ASCII" />

    <Message Text="Building Maizsim.dll with cl/link..." Importance="High" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; call &quot;$(VsDevCmd)&quot; -arch=x64 -host_arch=x64 &gt;nul &amp;&amp; call &quot;$(SetVarsBat)&quot; intel64 &gt;nul &amp;&amp; cd /d &quot;$(CropDir)&quot; &amp;&amp; rc /nologo /fo &quot;$(CppObjFromCrop)Crop.res&quot; &quot;Crop.rc&quot;" UseUtf8Encoding="Always" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; call &quot;$(VsDevCmd)&quot; -arch=x64 -host_arch=x64 &gt;nul &amp;&amp; call &quot;$(SetVarsBat)&quot; intel64 &gt;nul &amp;&amp; cd /d &quot;$(CropDir)&quot; &amp;&amp; cl @&quot;$(CppObjFromCrop)cl_$(Configuration)_$(Platform).rsp&quot;" UseUtf8Encoding="Always" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; call &quot;$(VsDevCmd)&quot; -arch=x64 -host_arch=x64 &gt;nul &amp;&amp; call &quot;$(SetVarsBat)&quot; intel64 &gt;nul &amp;&amp; cd /d &quot;$(CropDir)&quot; &amp;&amp; link @&quot;$(CppObjFromCrop)link_$(Configuration)_$(Platform).rsp&quot;" UseUtf8Encoding="Always" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" />

    <Error Condition="!Exists('$(ArtifactDir)Maizsim.dll') Or !Exists('$(CppObjDir)Maizsim.lib')" Text="C++ build did not produce Maizsim.dll in $(ArtifactDir) and Maizsim.lib in $(CppObjDir)." />

    <Message Text="Building 2dMAIZSIM.exe with ifx..." Importance="High" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; call &quot;$(VsDevCmd)&quot; -arch=x64 -host_arch=x64 &gt;nul &amp;&amp; call &quot;$(SetVarsBat)&quot; intel64 &gt;nul &amp;&amp; cd /d &quot;$(SoilDir)&quot; &amp;&amp; rc /nologo /fo &quot;$(FortranObjFromSoil)maizsim.res&quot; &quot;maizsim.rc&quot;" UseUtf8Encoding="Always" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" />
    <Exec Command="chcp 65001 &gt;nul &amp;&amp; call &quot;$(VsDevCmd)&quot; -arch=x64 -host_arch=x64 &gt;nul &amp;&amp; call &quot;$(SetVarsBat)&quot; intel64 &gt;nul &amp;&amp; cd /d &quot;$(SoilDir)&quot; &amp;&amp; ifx @&quot;$(FortranObjFromSoil)ifx_$(Configuration)_$(Platform).rsp&quot; /link /OUT:&quot;$(ArtifactFromSoil)2dMAIZSIM.exe&quot; /PDB:&quot;$(FortranObjFromSoil)2dsoil.pdb&quot; /SUBSYSTEM:CONSOLE" UseUtf8Encoding="Always" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" />

    <Error Condition="!Exists('$(ArtifactDir)2dMAIZSIM.exe')" Text="Fortran build did not produce 2dMAIZSIM.exe in $(ArtifactDir)." />
    <Message Text="Build complete: $(ArtifactDir)2dMAIZSIM.exe" Importance="High" />
    <Message Text="Build complete: $(ArtifactDir)Maizsim.dll" Importance="High" />
